# Copy to .env and fill in locally. Never commit .env.
# All values below are harmless placeholders.

# Runtime
RSE_ENV=local
RSE_LOG_LEVEL=INFO
RSE_RANDOM_SEED=42
RSE_DATA_DIR=data
RSE_EXPERIMENTS_DIR=experiments

# Database (planned: PostgreSQL + pgvector)
DATABASE_URL=postgresql://rse_user:change-me@localhost:5433/rse

# LLM provider (planned: Claude)
ANTHROPIC_API_KEY=replace-with-your-key
# Model IDs and prices live in configs/models.toml, not here.
RSE_LLM_LOG=experiments/llm_calls.jsonl

# Open-source models (planned)
RSE_EMBEDDING_MODEL=replace-with-embedding-model
RSE_RERANKER_MODEL=replace-with-reranker-model
HF_HOME=.cache/huggingface

# Docker Compose database (local only)
POSTGRES_USER=rse_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rse
POSTGRES_PORT=5433
